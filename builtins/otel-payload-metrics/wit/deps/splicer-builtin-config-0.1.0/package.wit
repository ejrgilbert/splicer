/// Splice-time-sealed config substrate for builtin middlewares.
/// Values are WAVE text on the wire.
package splicer:builtin-config@0.1.0;

interface get {
  /// Look up a config value by key. Returns `none` if the key was
  /// not set in the splice-config; the caller falls back to its
  /// own default.
  ///
  /// SYNC `func` (not `async func`) — load-bearing. See
  /// `docs/TODO/sync-wit-suspend-limit.md`. Substrate consumers
  /// are middleware hook bodies that may run inside an adapter
  /// task rooted in a sync-WIT export (whenever splicer wraps a
  /// sync-WIT interface), and a sync-rooted wasm task cannot
  /// block on a canon-lower-async subtask. Consumers MUST lower
  /// this import as plain `canon lower` (use a per-export async
  /// filter in `wit_bindgen::generate!` instead of `async: true`)
  /// and call it WITHOUT `.await`.
  get: func(key: string) -> option<string>;
}

world provider {
  export get;
}
